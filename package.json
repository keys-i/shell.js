{
  "name": "@keys-i/shell.js",
  "version": "0.0.0",
  "private": true,
  "description": "A small, safe, embeddable shell engine for the web",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./javascripts/index.js",
    "./wasm": "./wasm/shell.wasm",
    "./manuals/*": "./manuals/*"
  },
  "files": [
    "javascripts/block.js",
    "javascripts/classic.js",
    "javascripts/cpu/arm.js",
    "javascripts/cpu/jit.js",
    "javascripts/cpu/memory.js",
    "javascripts/cpu/x86.js",
    "javascripts/commands.js",
    "javascripts/elf.js",
    "javascripts/fs.js",
    "javascripts/index.js",
    "javascripts/man.js",
    "javascripts/machine.js",
    "javascripts/network.js",
    "javascripts/parser.js",
    "javascripts/profiles.js",
    "javascripts/shell.js",
    "javascripts/shell.min.js",
    "javascripts/syscall.js",
    "javascripts/ui.js",
    "javascripts/vm.js",
    "javascripts/wasm.js",
    "kernels/lib.rs",
    "manuals",
    "docs/MANUAL_SOURCES.md",
    "wasm/shell.wasm",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "rust-toolchain.toml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keys-i/shell.js.git"
  },
  "bugs": "https://github.com/keys-i/shell.js/issues",
  "homepage": "https://github.com/keys-i/shell.js#readme",
  "license": "SEE LICENSE IN docs/MANUAL_SOURCES.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark": "node tools/scripts/benchmark.js",
    "benchmark:ci": "node tools/scripts/benchmark.js",
    "browser": "node tools/scripts/browser.test.js",
    "build": "node tools/scripts/build.js",
    "format": "biome format --write . && cargo fmt",
    "format:check": "biome format . && cargo fmt --check",
    "lint": "biome lint .",
    "manuals": "node tools/scripts/manuals.js",
    "test": "node tools/scripts/test.js && cargo test",
    "validate": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "esbuild": "0.28.1"
  }
}
